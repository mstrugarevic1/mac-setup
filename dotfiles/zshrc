# ── Environment ───────────────────────────────────────────────

# Keep interactive editor choices consistent across command-line tools.
export EDITOR=vim
export VISUAL=vim

# Include executables installed directly for the current user without duplicating PATH entries.
typeset -U path PATH
path=("$HOME/.local/bin" $path)
[[ -d "$HOME/.rd/bin" ]] && path=("$HOME/.rd/bin" $path)


# ── History ────────────────────────────────────────────────────

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

# Share history between terminal sessions and remove duplicates.
setopt SHARE_HISTORY
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS


# ── Oh My Zsh and completion ──────────────────────────────────

# Load custom completion definitions before Oh My Zsh initializes completion.
typeset -U fpath FPATH
[[ -d "$HOME/.zfunc" ]] && fpath=("$HOME/.zfunc" $fpath)
if command -v brew >/dev/null 2>&1; then
    fpath=("$(brew --prefix)/share/zsh/site-functions" $fpath)
fi

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="pygmalion"
# aws: profile/region prompt helpers, kubectl: completion and aliases,
# kube-ps1: Kubernetes context/namespace segment used in RPROMPT below.
plugins=(git aws kubectl kube-ps1)
source "$ZSH/oh-my-zsh.sh"

zstyle ':completion:*' menu select

# ── Kubernetes prompt (kube-ps1) ──────────────────────────────
# Show the active cluster and namespace on the right side of the prompt.
# kubeon / kubeoff toggle it per session. Only wire it up if the plugin loaded.
if (( $+functions[kube_ps1] )); then
    KUBE_PS1_SYMBOL_ENABLE=false
    RPROMPT='$(kube_ps1)'
fi


# ── Keyboard navigation ────────────────────────────────────────

# Fn + Left/Right moves to the beginning/end of the command in common terminals.
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[4~' end-of-line


# ── Directory navigation ────────────────────────────────────────

# zoxide learns frequently used directories and provides the `z` command.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"


# ── Additional configuration ─────────────────────────────────────

# Optional files must not prevent a shell from starting when they do not exist.
[[ -f "$HOME/.aliases.zsh" ]] && source "$HOME/.aliases.zsh"
[[ -f "$HOME/.functions.zsh" ]] && source "$HOME/.functions.zsh"
if (( $+functions[git_folder_reminder] )); then
    autoload -Uz add-zsh-hook
    add-zsh-hook chpwd git_folder_reminder
fi
[[ -f "$HOME/.config/ai-cli-wrapper/scripts/ai-safe.sh" ]] && source "$HOME/.config/ai-cli-wrapper/scripts/ai-safe.sh"
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
