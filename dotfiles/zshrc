# ── Environment ───────────────────────────────────────────────

# Keep interactive editor choices consistent across command-line tools.
export EDITOR=vim
export VISUAL=vim

# Include executables installed directly for the current user without duplicating PATH entries.
typeset -U path PATH
path=("$HOME/.local/bin" $path)


# ── History ────────────────────────────────────────────────────

HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000

# Share history between terminal sessions and keep it compact.
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS


# ── Completion ───────────────────────────────────────────────

# Load user and Homebrew completion definitions before initializing native completion.
typeset -U fpath FPATH
[[ -d "$HOME/.zfunc" ]] && fpath=("$HOME/.zfunc" $fpath)
if command -v brew >/dev/null 2>&1; then
    fpath=("$(brew --prefix)/share/zsh/site-functions" $fpath)
fi
autoload -Uz compinit
compinit
zstyle ':completion:*' menu select


# ── Keyboard navigation ────────────────────────────────────────

# Fn + Left/Right moves to the beginning/end of the command in common terminals.
bindkey '^[[H' beginning-of-line
bindkey '^[[F' end-of-line
bindkey '^[[1~' beginning-of-line
bindkey '^[[4~' end-of-line


# ── Directory navigation ────────────────────────────────────────

# zoxide learns frequently used directories and provides the `z` command.
command -v zoxide >/dev/null 2>&1 && eval "$(zoxide init zsh)"


# ── Prompt ─────────────────────────────────────────────────────

# vcs_info is bundled with Zsh and supplies the current Git branch.
autoload -Uz vcs_info add-zsh-hook
setopt prompt_subst
zstyle ':vcs_info:git:*' formats ' %F{cyan}(%b)%f'
add-zsh-hook precmd vcs_info

# user@host:working-directory (git-branch) followed by % or # for root.
PROMPT='%F{green}%n@%m%f:%F{blue}%~%f${vcs_info_msg_0_} %# '


# ── Additional configuration ─────────────────────────────────────

# Optional files must not prevent a shell from starting when they do not exist.
[[ -f "$HOME/.aliases.zsh" ]] && source "$HOME/.aliases.zsh"
[[ -f "$HOME/.functions.zsh" ]] && source "$HOME/.functions.zsh"
[[ -f "$HOME/.config/ai-cli-wrapper/scripts/ai-safe.sh" ]] && source "$HOME/.config/ai-cli-wrapper/scripts/ai-safe.sh"
[[ -f "$HOME/.zshrc.local" ]] && source "$HOME/.zshrc.local"
